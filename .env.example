# Supabase 接続情報（値は .env.local に入れる。このファイルにはキー名だけ・値は空）
# 取得場所：Supabaseダッシュボード → プロジェクト dores-dev → Project Settings → API

# ブラウザ・サーバー両方で使う（公開前提の匿名キー。NEXT_PUBLIC_ で画面に露出してよい）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# サーバー専用。絶対に画面側（ブラウザで動くコード）に入れない・コミットしない
SUPABASE_SERVICE_ROLE_KEY=
